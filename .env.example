# 앱 런타임용. Supabase Session/Transaction pooler (포트 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Prisma 마이그레이션용. Supabase Session pooler (포트 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# /admin 로그인 비밀번호
ADMIN_PASSWORD="change-me"
