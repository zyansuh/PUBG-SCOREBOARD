generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 팀 이름은 사람이 확정한 표기 그대로 저장한다.
/// Supabase Postgres에 저장한다. 화면은 Prisma를 직접 부르지 않고 src/lib/db.ts만 사용한다.
model Team {
  id        String        @id @default(cuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  results   MatchResult[]
}

model Match {
  id        String        @id @default(cuid())
  imageHash String        @unique
  playedAt  DateTime
  createdAt DateTime      @default(now())
  results   MatchResult[]

  @@index([playedAt])
}

model MatchResult {
  id              String @id @default(cuid())
  matchId         String
  teamId          String
  rank            Int
  kills           Int
  placementPoints Int
  killPoints      Int
  totalPoints     Int
  match           Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team            Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([matchId, teamId])
  @@index([teamId])
  @@index([matchId])
}
