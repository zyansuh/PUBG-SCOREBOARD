generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 팀 이름은 사람이 확정한 표기 그대로 저장한다.
/// Supabase로 옮길 때는 provider를 postgresql로 바꾸고 DATABASE_URL만 교체하면 된다.
model Team {
  id        String        @id @default(cuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  results   MatchResult[]
}

model Match {
  id        String        @id @default(cuid())
  imageHash String        @unique
  playedAt  DateTime
  createdAt DateTime      @default(now())
  results   MatchResult[]

  @@index([playedAt])
}

model MatchResult {
  id              String @id @default(cuid())
  matchId         String
  teamId          String
  rank            Int
  kills           Int
  placementPoints Int
  killPoints      Int
  totalPoints     Int
  match           Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team            Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([matchId, teamId])
  @@index([teamId])
  @@index([matchId])
}
